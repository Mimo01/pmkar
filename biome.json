{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "*.ts", "*.js"],
    "experimentalScannerIgnores": ["node_modules", "dist", "target", "src-tauri"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "recommended": true },
      "suspicious": { "recommended": true },
      "style": { "recommended": true, "noNonNullAssertion": "off" },
      "performance": { "recommended": true },
      "security": {
        "recommended": true,
        "noDangerouslySetInnerHtml": "off"
      },
      "a11y": { "recommended": true },
      "complexity": { "recommended": true }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "trailingNewline": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "arrowParentheses": "always",
      "trailingCommas": "all"
    },
    "jsxRuntime": "transparent"
  },
  "json": {
    "formatter": { "indentWidth": 2 }
  }
}
