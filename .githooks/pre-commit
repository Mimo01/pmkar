#!/bin/sh
# Pre-commit hook: run the same checks as CI

echo "Running pre-commit checks..."

# Biome lint + format
npm run lint 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Biome check failed. Run: npm run lint:fix && npm run format"
  exit 1
fi

# Rust format check
cargo fmt --check 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Rust format check failed. Run: cargo fmt"
  exit 1
fi

# Rust clippy
cargo clippy -- -D warnings 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Clippy check failed. Fix warnings above."
  exit 1
fi

echo "✓ Pre-commit checks passed"
